# ============================================================
# Scalpair — Crypto Scalping Screener & AI Terminal
# Copy to .env and adjust. All values have sane defaults.
# NO API KEYS REQUIRED — 100% public, read-only market data.
# ============================================================

# --- Feed selection ---
# binance  = Binance USDⓈ-M futures public WS (primary)
# bybit    = Bybit v5 public linear WS (fallback)
# okx      = OKX v5 public swap WS (fallback)
# mock     = synthetic local generator (fully offline demo)
DATA_FEED=auto
# Number of most-liquid USDT perpetuals to track (majors first; okx/bybit/binance sources)
TOP_SYMBOLS=50

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Redis (optional: pub/sub fan-out + cache; falls back to in-memory) ---
REDIS_URL=redis://redis:6379/0

# --- Database ---
# SQLite (WAL) by default; switch to PostgreSQL by changing the URL
DATABASE_URL=sqlite+aiosqlite:///./data/scalpair.db

# --- Auth (JWT scaffolding; change in production) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- ML engine ---
# Seconds between scoring ticks per asset
ML_SCORE_INTERVAL=15
# Blend weight of the heuristic score vs anomaly model (0..1)
ML_HEURISTIC_WEIGHT=0.65
# Wall detection multiplier over rolling median level notional
WALL_MULTIPLIER=3.0

# --- Broadcaster ---
# Max broadcasts per second to each frontend client
WS_BROADCAST_RATE=6

# --- Frontend (nginx) ---
FRONTEND_PORT=8080
BACKEND_UPSTREAM=backend:8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Telegram alerts (optional; alerts stay in-app when unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
